# --- Base de données ---------------------------------------------------------
# Local (docker compose up -d) :
DATABASE_URL=postgresql://bookrich:bookrich@localhost:5432/bookrich
# Production (NeonDB, utiliser l'URL "pooled") :
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full

# --- BetterAuth --------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-please-use-a-long-random-string
# En local, laissez vide : l'URL est déduite de la requête (n'importe quel port fonctionne).
# En production, renseignez l'URL publique, ex. https://bookrich.vercel.app
BETTER_AUTH_URL=
# Code d'invitation optionnel : s'il est renseigné, il est exigé à l'inscription.
INVITE_CODE=

# --- OpenAI (extraction depuis un lien + recherche IA) ------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# --- Recherche "classique" (optionnelle) --------------------------------------
# Photon / OpenStreetMap fonctionne sans clé. Google Places est activé si une clé est fournie.
GOOGLE_PLACES_API_KEY=

# --- Stockage des photos -----------------------------------------------------
# En local, les photos sont écrites dans ./storage/uploads.
# Sur Vercel, renseigner le token Blob pour stocker dans Vercel Blob.
BLOB_READ_WRITE_TOKEN=

# --- Utilisateur par défaut (script `npm run db:seed`) -----------------------
SEED_USER_EMAIL=vous@exemple.com
# Laissez vide pour qu'un mot de passe soit généré et affiché une seule fois.
SEED_USER_PASSWORD=
SEED_USER_NAME=Camille & Louis

# --- Site & e-mails (Resend) --------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://lepigeonexigeant.fr
RESEND_API_KEY=
RESEND_FROM="Le Pigeon Exigeant <noreply@lepigeonexigeant.fr>"
RESEND_REPLY_TO=bonjour@lepigeonexigeant.fr
# Reçoit une notification à chaque demande d'accès (vide = aucune notification).
ACCESS_REQUEST_NOTIFY_EMAIL=vous@exemple.com
# Signature « Fait avec ♥ par un pigeon exigeant » dans les pieds de page.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
